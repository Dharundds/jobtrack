# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# 32-byte key, base64-encoded (openssl rand -base64 32)
TOKEN_ENC_KEY=

# Session cookie signing secret (openssl rand -base64 32)
SESSION_SECRET=

PORT=8080
SYNC_INTERVAL_MINUTES=5
APP_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=console

# After Google OAuth, redirect here (Vite dev server). Leave empty in prod when UI is embedded.
FRONTEND_URL=http://localhost:5173

# Gmail API throttling (quota units per minute; messages.get/list = 5 each)
GMAIL_UNITS_PER_MIN=2500
GMAIL_CONCURRENCY=3
